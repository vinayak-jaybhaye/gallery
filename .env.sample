# ╔══════════════════════════════════════════════════════════════════╗
# ║                    LOCAL DEPLOYMENT                              ║
# ║  Uses Docker infrastructure (Postgres, Redis, LocalStack)        ║
# ║  Run with: docker compose up --build                             ║
# ╚══════════════════════════════════════════════════════════════════╝

NODE_ENV=development
HOST=localhost
DEV_USER_EMAIL=dev@gallery.local

JWT_SECRET=randomlongstring
PORT=3000

DATABASE_URL=postgresql://user:password@localhost:5432/gallery
REDIS_URL=redis://localhost:6379
# MEDIA_WORKER_CONCURRENCY=5

# S3 via LocalStack
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=gallery-bucket

FRONTEND_URL=http://${HOST}:5173
VITE_API_URL=http://${HOST}:3000
S3_PUBLIC_ENDPOINT=http://${HOST}:4566

# Google OAuth (API verifies tokens; web needs the VITE_ copy for the sign-in button)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_client_id


# ╔══════════════════════════════════════════════════════════════════╗
# ║                    CLOUD DEPLOYMENT                              ║
# ║  Uses real AWS S3, managed Postgres & Redis                      ║
# ║  Uncomment this block and comment the LOCAL block to use         ║
# ║  Run with: docker compose -f docker-compose.cloud.yml up         ║
# ╚══════════════════════════════════════════════════════════════════╝

# NODE_ENV=production
#
# JWT_SECRET=<generate-a-strong-random-secret>
# PORT=3000
#
# DATABASE_URL=postgresql://user:password@your-rds-host:5432/gallery
# REDIS_URL=redis://your-elasticache-host:6379
#
# # AWS S3 (real)
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# S3_BUCKET=your-s3-bucket-name
# # No S3_ENDPOINT — uses real AWS
#
# FRONTEND_URL=https://yourdomain.com
# VITE_API_URL=https://api.yourdomain.com
#
# # Google OAuth
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# VITE_GOOGLE_CLIENT_ID=your_google_client_id