NODE_ENV=development
DEV_USER_EMAIL=dev@gallery.local
FRONTEND_URL=http://localhost:5173

JWT_SECRET=randomlongstring
PORT=3000

DATABASE_URL=postgresql://user:password@localhost:5432/gallery

# Redis (BullMQ media processing queue)
REDIS_URL=redis://localhost:6379
# MEDIA_WORKER_CONCURRENCY=5

#localstack
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=gallery-bucket

# AWS S3 (cloud)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# S3_BUCKET=your_bucket_name

# google oauth (API verifies tokens; web needs the VITE_ copy for the sign-in button)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# optional; defaults to http://localhost:3000
# VITE_API_URL=http://localhost:3000