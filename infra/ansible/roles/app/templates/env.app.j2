NODE_ENV={{ node_env | default('development') }}
DEV_USER_EMAIL={{ dev_user_email | default('dev@gallery.local') }}

JWT_SECRET={{ jwt_secret }}
PORT=3000

DATABASE_URL=postgresql://{{ db_user }}:{{ db_password }}@{{ db_private_ip }}:5432/{{ db_name }}
REDIS_URL=redis://{{ db_private_ip }}:6379

# S3 (real AWS)
AWS_REGION={{ aws_region }}
AWS_ACCESS_KEY_ID={{ s3_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ s3_secret_access_key }}
S3_BUCKET={{ s3_bucket_name }}
# No S3_ENDPOINT — uses real AWS

FRONTEND_URL=http://{{ app_public_ip }}
VITE_API_URL=http://{{ app_public_ip }}:3000

GOOGLE_CLIENT_ID={{ google_client_id | default(GOOGLE_CLIENT_ID | default('')) }}
GOOGLE_CLIENT_SECRET={{ google_client_secret | default(GOOGLE_CLIENT_SECRET | default('')) }}
VITE_GOOGLE_CLIENT_ID={{ google_client_id | default(GOOGLE_CLIENT_ID | default('')) }}

MEDIA_WORKER_CONCURRENCY=4
