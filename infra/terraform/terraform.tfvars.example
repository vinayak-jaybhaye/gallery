# Example: create a terraform.tfvars file with your values
# cp terraform.tfvars.example terraform.tfvars

aws_region     = "ap-south-1"
key_name       = "your-ec2-key-pair-name"
s3_bucket_name = "gallery-media-bucket-unique-suffix"
db_password    = "a-strong-db-password"
jwt_secret     = "a-long-random-jwt-secret"
