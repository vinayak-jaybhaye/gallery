{
  "name": "gallery",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:api": "dotenv -e .env -- pnpm --filter gallery-api dev",
    "dev:web": "pnpm --filter gallery-web dev",
    "dev:worker": "dotenv -e .env -- pnpm --filter media-worker dev",
    "build": "pnpm -r build",
    "db:generate": "dotenv -e .env -- pnpm --filter @gallery/db db:generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @gallery/db db:migrate",
    "db:push": "dotenv -e .env -- pnpm --filter @gallery/db db:push",
    "db:studio": "dotenv -e .env -- pnpm --filter @gallery/db db:studio",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "cloud:up": "docker compose -f docker-compose.cloud.yml up -d --build",
    "cloud:down": "docker compose -f docker-compose.cloud.yml down",
    "cloud:logs": "docker compose -f docker-compose.cloud.yml logs -f",
    "dev": "docker compose up --build",
    "bench": "dotenv -e .env -- pnpm --filter bench run bench",
    "bench:api": "dotenv -e .env -- pnpm --filter bench run bench:api",
    "bench:worker": "dotenv -e .env -- pnpm --filter bench run bench:worker",
    "bench:db": "dotenv -e .env -- pnpm --filter bench run bench:db",
    "bench:s3": "dotenv -e .env -- pnpm --filter bench run bench:s3",
    "bench:concurrent": "dotenv -e .env -- pnpm --filter bench run bench:concurrent"
  },
  "packageManager": "pnpm@10.29.2",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.19.0"
  }
}